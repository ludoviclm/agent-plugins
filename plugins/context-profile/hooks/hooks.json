{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; $p -c '' 2>/dev/null || p=python; $p \"${CLAUDE_PLUGIN_ROOT}/skills/context-profile/scripts/apply.py\" --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
